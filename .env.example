# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Optional server-side passcode for the Golden Samui Admin Dashboard.
# If left empty, the first visit to /admin provides a one-time password setup form.
ADMIN_PASSWORD=
